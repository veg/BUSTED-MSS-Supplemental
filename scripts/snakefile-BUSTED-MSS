######################
## Helper Functions ##
######################
# handle the case where some alignments have different file names, because they've been filtered
def format_input(wildcards):
    curr_file = [f for f in MSAs if wildcards.file in f]
    if 'FILTER' in curr_file[0]:
        return resultDirectory + "/post_msa/" + curr_file[0] + ".msa"
    else:
        return resultDirectory + "/post_msa/" + wildcards.file + ".msa"


##################
## BEGIN SCRIPT ##
##################
print("Files are: ", FILES)

rule all:
    input:
        expand(os.path.join(resultDirectory, "BUSTED-MSS-" + mss_type, "{GENE}.BUSTED-MSS.json"), GENE = FILES),
        expand(os.path.join(resultDirectory, "BUSTED-MSS-" + mss_type, "{GENE}.BUSTED-MSS-fit.lf"), GENE = FILES)

rule busted:
    input:
        seq = format_input,
        tree = os.path.join(dataDirectory, "raxml", "{file}.msa.raxml.bestTree")
    output:
        json = os.path.join(resultDirectory, "BUSTED-MSS-" + mss_type, "{file}.BUSTED-MSS.json"),
        fits = os.path.join(resultDirectory, "BUSTED-MSS-" + mss_type, "{file}.BUSTED-MSS-fit.lf")
    threads: NP
    resources:
        tasks=NP,                  # SLURM --ntasks (MPI ranks)
        nodes=1,                   # SLURM --nodes
        cpus_per_task=1,           # SLURM --cpus-per-task (per rank)
        mem_mb=4000,
        runtime=120,
        mpi="srun",
    log: 
        stdout="slurm-logs/out/bustedMSS.{file}.out",
        stderr="slurm-logs/err/bustedMSS.{file}.err"
    shell:
        # LIBPATH={LIBPATH}
        """
        mkdir -p {resultDirectory}/BUSTED-MSS-{mss_type}

#        {resources.mpi} --mpi=pmix \
#        --ntasks {resources.tasks} \
#        --cpus-per-task {resources.cpus_per_task}

        {hyphy} busted \
        --alignment {input.seq} \
        --tree {input.tree} \
        --mss Yes \
        {ARGS} \
        --starting-points 5 \
        --srv No \
        --error-sink Yes \
        --output {output.json} \
        --save-fit {output.fits} > \
        {log.stdout} 2> \
        {log.stderr}
        """

