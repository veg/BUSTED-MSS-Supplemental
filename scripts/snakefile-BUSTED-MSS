import subprocess

######################
## Helper Functions ##
######################
def get_list(filename):
    """extract a list of files to be analyzed, provided in FILENAME"""
    my_list = []
    with open(filename, 'r') as data_in:
        for line in data_in:
            my_list.append(line.strip())
    return(my_list)

###################
## Configuration ##
###################
configfile: "config-BUSTED-MSS.yaml"

# Config file should specify:
# # - dataDirectory: Full path to the directory containing the folder of codon-aware gene alignments and the folder of trees.
# # - resultDirectory: Full path to the directory in which to place the folder of BUSTED results
# # - np: Number of processes for MPI.
NP = config['np']
dataDirectory = config['dataDirectory']
resultDirectory = config['resultDirectory']
mss_type = config['mss-type']
mssFile = config['mss-file']

FILES = glob_wildcards(resultDirectory + "/raxml/{file}.msa.raxml.bestTree").file
MSAs = glob_wildcards(resultDirectory + "/post_msa/{file}.msa").file

ARGS = "--mss-type "

if mss_type == "Full":
    ARGS += '"Full"'
    
elif mss_type == "SynREV":
    print("Warning: SynREV is not currently supported for BUSTED+MSS and should be disabled.")
    ARGS += '"SynREV"'
    
elif mss_type == "SynREV2":
    ARGS += '"SynREV2"'
    
elif mss_type == "SynREV2g":
    ARGS += '"SynREV2g"'
    
elif mss_type == "SynREVCodon":
    # MSS rates must be estimated relative to each other (with a constrained mean of 1),
    # rather than relative to dN (which is incompatible with the way BUSTED estimates rates)
    ARGS += '"SynREVCodon" --mss-reference-rate "synonymous"'
    
elif mss_type == "Random":
    if not mssClasses:
        mssClasses = 2  # Default value
    ARGS += '"Random" --mss-classes ' + str(mssClasses)
    
elif mss_type == "Empirical":
    if not mssFile:
        raise ValueError("For 'Empirical', --mss-file must be specified")
    ARGS += '"Empirical" --mss-file ' + mssFile
    
elif mss_type == "File":
    if not mssFile:
        raise ValueError("For 'File', the path to the TSV partition file must be specified")
    ARGS += '"File" --mss-file ' + mssFile + ' --mss-neutral "NEUTRAL"'
    
elif mss_type == "Codon-file":
    if not mssFile:
        raise ValueError("For 'Codon-file', the path to the TSV partition file must be specified")
    ARGS += '"Codon-file" --mss-file ' + mssFile + ' --mss-neutral "NEUTRAL"'
    
else:
    raise ValueError(f"Unknown mss_type: {mss_type}")


