######################
## Helper Functions ##
######################
def get_list(filename):
    """extract a list of files to be analyzed, provided in FILENAME"""
    my_list = []
    with open(filename, 'r') as data_in:
        for line in data_in:
            my_list.append(line.strip())
    return(my_list)

###################
## Configuration ##
###################
configfile: "config-BUSTED.yaml"

# Config file should specify:
# # - dataDirectory: Full path to the directory containing the folder of codon-aware gene alignments and the folder of trees.
# # - resultDirectory: Full path to the directory in which to place the folder of BUSTED results
# # - np: Number of processes for MPI.
NP = config['np']
dataDirectory = config['dataDirectory']
resultDirectory = config['resultDirectory']

MSAs = glob_wildcards(os.path.join(dataDirectory, "post_msa", "{file}.msa")).file
FILES = glob_wildcards(os.path.join(dataDirectory, "raxml", "{file}.msa.raxml.bestTree")).file

################
## HYPHY vars ##
################
